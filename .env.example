# Environment Variables for Hospital Management System
# Copy this file to .env.local and update the values as needed
# Note: Only variables prefixed with VITE_ are accessible in the browser

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api

# Database Configuration
VITE_DB_HOST=localhost
VITE_DB_USER=root
VITE_DB_PASSWORD=
VITE_DB_NAME=medcare_rural
VITE_DB_PORT=3306

# Application Configuration
# Set to 'false' to disable automatic sync with backend server
VITE_AUTO_SYNC=true

# Offline Functionality Control
# Set to 'false' to completely disable offline functionality and force online-only mode
# When disabled: No IndexedDB, no service worker, no demo authentication, requires internet connection
VITE_OFFLINE_ENABLED=false

# Optional: External Service Keys (if needed)
# VITE_RAZORPAY_KEY=your_razorpay_key
# VITE_SMS_API_URL=your_sms_api_url
# VITE_SMS_API_KEY=your_sms_api_key
# VITE_TWILIO_API_KEY=your_twilio_api_key
# VITE_TWILIO_FROM_NUMBER=your_twilio_from_number
# VITE_ENCRYPTION_KEY=your_encryption_key
# VITE_JWT_SECRET=your_jwt_secret
